    "@capacitor/status-bar": "7.0.6",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
